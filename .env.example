# คัดลอกไฟล์นี้เป็น .env แล้วแก้ค่าตามต้องการ
# คำสั่ง: cp .env.example .env

# พอร์ตที่เว็บจะรัน
PORT=3000

# พอร์ตบนเครื่อง Server ที่ส่งต่อเข้า container เลือกค่าที่ไม่ชนเว็บอื่น
# ตัวอย่าง Server ที่มีหลายเว็บ: HOST_PORT=3101
HOST_PORT=3000
NODE_ENV=development

# กุญแจลับสำหรับเข้ารหัส session (ตั้งเป็นข้อความสุ่มยาวๆ ห้ามบอกใคร)
SESSION_SECRET=

# กุญแจเข้ารหัส Telegram Bot Token ต้องเป็นคนละค่ากับ SESSION_SECRET
APP_ENCRYPTION_KEY=

# รหัสใช้ครั้งเดียวสำหรับป้องกันบุคคลอื่นยึดบัญชีระหว่างตั้งค่าครั้งแรก
# production ควรกำหนดเสมอ หลังสร้างผู้ใช้แรกแล้วจะลบออกได้
SETUP_TOKEN=

# ถ้ารันหลัง reverse proxy ที่เป็น https (เช่น nginx/caddy) ให้ตั้งเป็น true
# เพื่อให้ cookie ของ session ทำงานถูกต้อง
TRUST_PROXY=false
COOKIE_SECURE=false

# Google Login (Google Identity Services)
# สร้าง OAuth 2.0 Client ID ชนิด Web application แล้วนำ Client ID มาใส่ที่นี่
# Authorized JavaScript origins สำหรับเครื่องนี้: http://localhost:3000
GOOGLE_CLIENT_ID=

# จำกัดอีเมล Google ที่อนุญาตให้ใช้ระบบ (คั่นหลายอีเมลด้วยเครื่องหมายจุลภาค)
# เว้นว่างได้: หากมีผู้ใช้เดิม บัญชี Google ใหม่ต้องเชื่อมจากหน้าตั้งค่าของบัญชีเดิมก่อน
GOOGLE_ALLOWED_EMAILS=

# ไม่แนะนำให้ Google สร้างผู้ใช้คนแรกอัตโนมัติ ให้ตั้งค่าบัญชีหลักก่อน
GOOGLE_ALLOW_FIRST_USER=false

# สำรองข้อมูลอัตโนมัติวันละครั้ง เขียนไฟล์ JSON ลงโฟลเดอร์ data/backups
# ปิดได้ด้วย false, เวลาเป็น HH:mm ตามเวลาไทย, keep คือจำนวนไฟล์ล่าสุดที่เก็บไว้ต่อผู้ใช้
AUTO_BACKUP_ENABLED=true
AUTO_BACKUP_TIME=03:00
AUTO_BACKUP_KEEP=7
